#!/usr/bin/env bash
# dshctl —— dsh web 服务的安装、升级与托管
#
# 只管一件事：把官方 npm 包 @deepseek-ai/dsh 装进全局树，并作为 systemd 用户服务跑起来。
# 没有第二个安装位置，也没有「运行来源」开关：装的就是跑的。
#
# 用法：
#   dshctl                     交互菜单
#   dshctl upgrade [通道|版本]  安装/升级官方包（默认沿用记住的通道）
#   dshctl install             首次安装：把 dshctl 放进 PATH、写服务单元并完成安装
#   dshctl status              服务状态 + 已装版本 + 「进程是否还跑着旧代码」
#   dshctl log                 最近日志
#   dshctl restart|start|stop  服务控制
#   dshctl check               预检：已装版本能否用当前 profile 启动（不重启）
#   dshctl repair              重建 systemd 单元（原配置先备份）
#   dshctl self-update         更新 dshctl 自身
#   dshctl help                完整说明
#   通用开关：--dry-run 只说不做；--no-restart 装完不重启
#
# 三条硬规则，都是踩过坑之后加的：
#   1. 命令行里出现 help / -h / --help 只打印帮助；其余「- 开头」的未知参数一律拒绝
#      执行，不猜（曾因 `dshctl use official --help` 把 --help 当普通参数吞掉）。
#   2. 预检必须在正式安装之前跑在暂存件上。全局 npm 树就是正在运行的那份安装，
#      `npm i -g` 先落地再预检等于拿线上做实验——2026-11-03 实测：rc.2 的进程按需
#      加载 rc.5 的 text.js，新会话直接报 does not provide an export named 'ownedSlice'。
#      所以顺序固定为：隔离暂存 → 预检 → 提交 → 重启，重启失败自动装回上一个版本。
#   3. 预检必须在「不占用线上端口」的前提下跑。profile 可能把监听端口写死
#      （remote-web-ui 的 lan-bind 块会写 host-webserver.port，配置优先于 --port），
#      所以临时 DSH_HOME 里也要把那个端口改到空闲端口，否则预检永远 EADDRINUSE。
#
# 还有一条不叫规则但体现在输出里：磁盘上的版本比运行中的进程新时必须直说。
# 那种状态下服务、日志、HTTP 应答全都「正常」，故障只在浏览器里现形。
set -u

UNIT="dsh-web.service"
UNIT_FILE="$HOME/.config/systemd/user/$UNIT"
HOST="127.0.0.1"
PORT=3080
URL="http://$HOST:$PORT"
PACKAGE_NAME="@deepseek-ai/dsh"
# 服务单元由 dshctl 生成，固定跑 `dsh web`，端口固定 —— 所以 profile 与端口是常量。
PROFILE="web"


# 状态：更新通道与「上一个版本」（回滚用）。
STATE_DIR="$HOME/.config/dsh"
CHANNEL_FILE="$STATE_DIR/channel"
PREV_VERSION_FILE="$STATE_DIR/previous-version"

# 已废弃的双槽位模型留下的 drop-in：存在时服务会指向早已没人维护的本地槽位，
# 启动时清掉（这是一次性迁移，不是功能）。
LEGACY_DROPIN_DIR="$HOME/.config/systemd/user/$UNIT.d"
LEGACY_DROPINS="$LEGACY_DROPIN_DIR/50-dshctl-slot.conf $LEGACY_DROPIN_DIR/50-dshctl-source.conf"

# dshctl 自身版本与远端基址：self-update 时对比仓库根的 VERSION 文件。
DSHCTL_VERSION="0.6.0"
DSHCTL_RAW_BASE="https://raw.githubusercontent.com/stofancy/dshctl/main"

# 过程开关：--dry-run 只打印计划；--no-restart 装完不重启。
DRY_RUN=0
RESTART=1

# 暂存件的根目录，由 stage_install 填入。用全局变量而不是 stdout 回传，
# 免得安装过程的提示语混进返回值。
STAGE_ROOT=""

# ── 状态读写 ─────────────────────────────────────────────────────────────
# 读取枚举型状态。文件缺失或不可读时输出空串，由调用方决定回退值；
# 绝不因为状态文件损坏而中断。
read_state() {
    local file="$1"
    [ -r "$file" ] || return 0
    tr -d '[:space:]' < "$file" 2>/dev/null
}

# 原子写入一行状态：先写临时文件再 mv，避免中断留下截断内容把记忆弄坏。
write_state() {
    local file="$1" value="$2" tmp="$1.tmp.$$"
    mkdir -p "$(dirname "$file")" || return 1
    if printf '%s\n' "$value" > "$tmp" 2>/dev/null; then
        mv -f "$tmp" "$file"
    else
        rm -f "$tmp"
        return 1
    fi
}

# ── 通用工具 ─────────────────────────────────────────────────────────────
# dist-tag 只认这三个；也允许显式版本号（形如 0.2.1-rc.5）。
valid_channel() {
    case "$1" in
        latest|next|alpha) return 0 ;;
        [0-9]*.[0-9]*.[0-9]*) return 0 ;;
        *) return 1 ;;
    esac
}

# 当前更新通道。记忆缺失、为空或含非法值时回落 latest——否则一个手改坏的值会让
# 此后每次裸 upgrade 都永久失败（写回发生在安装成功之后，无法自愈）。
current_channel() {
    local c
    c=$(read_state "$CHANNEL_FILE")
    if [ -n "$c" ] && valid_channel "$c"; then
        printf '%s' "$c"
    else
        [ -n "$c" ] && echo "⚠ 记忆的更新通道无效（$c），本次回退 latest" >&2
        printf 'latest'
    fi
}

# 本次要装的目标：显式通道/版本优先，否则沿用记忆的通道。
resolve_tag() {
    printf '%s' "${1:-$(current_channel)}"
}

# npm 全局前缀（唯一安装位置）。惰性求值并缓存，避免每条命令都调 npm。
npm_prefix() {
    if [ -z "${NPM_PREFIX_CACHE:-}" ]; then
        NPM_PREFIX_CACHE=$(npm prefix -g 2>/dev/null) || NPM_PREFIX_CACHE=""
    fi
    [ -n "$NPM_PREFIX_CACHE" ] || return 1
    printf '%s' "$NPM_PREFIX_CACHE"
}

# 全局树里的 dsh 入口。装了就是它，没有第二个候选。
dsh_bin() {
    local prefix
    prefix=$(npm_prefix) || return 1
    printf '%s' "$prefix/bin/dsh"
}

# 已装版本；读不到时报「未知」，不中断流程。
installed_version() {
    local bin
    bin=$(dsh_bin 2>/dev/null) || { printf '未知'; return 0; }
    [ -x "$bin" ] || { printf '未安装'; return 0; }
    "$bin" --version 2>/dev/null || printf '未知'
}

# 带旋转指示器的后台执行：spinner <描述> -- cmd...
spinner() {
    local desc="$1"; shift
    [ "$1" = "--" ] && shift
    local frames='|/-\' i=0 pid rc
    "$@" &
    pid=$!
    # 非 TTY 或非交互时不画 spinner，只等结果
    if [ ! -t 2 ]; then
        wait "$pid"; return $?
    fi
    printf '  %s ' "$desc"
    while kill -0 "$pid" 2>/dev/null; do
        printf '\b%c' "${frames:i++%4:1}"
        sleep 0.15
    done
    wait "$pid"; rc=$?
    printf '\b'
    if [ $rc -eq 0 ]; then echo "✔ 完成"
    elif [ $rc -eq 124 ]; then echo "✘ 超时"
    else echo "✘ 失败 (exit=$rc)"; fi
    return $rc
}

# ── 网络前置检查 ─────────────────────────────────────────────────────────
# 代理只做 TCP 探测，不依赖 curl。
proxy_reachable() {
    local hostport="${1#*://}" host port
    hostport="${hostport%%/*}"
    host="${hostport%%:*}"
    port="${hostport##*:}"
    [ "$host" != "$port" ] || port=80
    [ -n "$host" ] || return 1
    # 连接必须带超时：目标是丢包而不是拒绝时，裸连会一直挂着。
    timeout 2 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null
}

# npm 失败最容易被误读成「安装失败」的两种根因：代理挂了、镜像还没同步目标版本。
# 代理不可达时不让它伪装成安装问题：能直连就本次直连，不能直连就明确报错。
# 这确实会改动本进程的环境变量——dshctl 是一次性进程，且发生在动手安装之前。
network_precheck() {
    local proxy registry
    proxy="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"
    [ -n "$proxy" ] || return 0
    proxy_reachable "$proxy" && return 0
    echo "⚠ 代理不可达：$proxy" >&2
    registry=$(npm config get registry 2>/dev/null || true)
    [ -n "$registry" ] || registry="https://registry.npmjs.org"
    if command -v curl >/dev/null 2>&1 && \
       ( unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy; \
         curl -fsS --max-time 8 -o /dev/null "$registry/" ) 2>/dev/null; then
        unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
        export no_proxy='*' NO_PROXY='*'
        echo "  本次直连 $registry（仅影响这次运行）" >&2
        return 0
    fi
    echo "  直连 $registry 也不通：先恢复代理，或换一个可用的 registry，再重试。" >&2
    return 1
}

# dist-tag / 版本号 → 确切版本。镜像同步滞后时 dist-tag 已经指过去、版本却还没落地，
# 这时说清原因，比把 npm 的 ERR 原样糊出来有用。
npm_view_version() {
    local tag="$1" out
    command -v npm >/dev/null 2>&1 || { echo "未找到 npm，无法解析 $tag" >&2; return 1; }
    if ! out=$(npm view "$PACKAGE_NAME@$tag" version 2>&1); then
        echo "取不到 $PACKAGE_NAME@$tag 的版本：" >&2
        printf '%s\n' "$out" | sed 's/^/    /' | head -5 >&2
        case "$out" in
            *ECONNREFUSED*|*ENOTFOUND*|*EAI_AGAIN*|*ETIMEDOUT*|*ECONNRESET*)
                echo "    → 网络或代理问题：先确认 npm 能访问 registry" >&2 ;;
            *E404*|*404*|*"No matching version"*)
                echo "    → registry 里没有 $tag；镜像未同步时可稍后重试，或用显式版本号" >&2 ;;
        esac
        return 1
    fi
    printf '%s' "$(printf '%s\n' "$out" | tail -1 | tr -d '[:space:]')"
}

# ── 漂移检测 ─────────────────────────────────────────────────────────────
# 磁盘上的包装得比进程启动还晚 = 进程内存里还是旧代码。这类故障只在浏览器里现形
# （新会话按需加载新文件，撞上旧进程的模块表），服务状态、日志、HTTP 全是「正常」。
running_stale() {
    local prefix pkg installed_epoch started start_epoch
    prefix=$(npm_prefix) || return 1
    pkg="$prefix/lib/node_modules/$PACKAGE_NAME/package.json"
    [ -f "$pkg" ] || return 1
    installed_epoch=$(stat -c %Y "$pkg" 2>/dev/null) || return 1
    started=$(systemctl --user show "$UNIT" -p ActiveEnterTimestamp --value 2>/dev/null) || return 1
    [ -n "$started" ] || return 1
    start_epoch=$(LC_ALL=C date -d "$started" +%s 2>/dev/null) || return 1
    [ "$installed_epoch" -gt "$start_epoch" ]
}

# 只在真的漂移时出声，避免把正常状态说成告警。
warn_if_stale() {
    running_stale || return 0
    echo "⚠ 磁盘上的包比运行中的进程新：进程还跑着旧代码。" >&2
    echo "  新会话可能因新旧模块混载而失败（例如某些导出不存在）。执行：dshctl restart" >&2
    return 0
}

# ── dshctl 自身：自更新 ──────────────────────────────────────────────────
# 从仓库拉最新脚本，校验后原子替换。校验三道：bash 语法必须过、版本号必须是远端
# VERSION 宣称的那个、下载失败不动原文件——半截脚本绝不能把正在用的 dshctl 换坏。
self_update() {
    local self tmp remote
    command -v curl >/dev/null 2>&1 || { echo "自更新需要 curl，未做任何改动" >&2; return 1; }
    self=$(readlink -f "${BASH_SOURCE[0]}")
    remote=$(curl -fsSL --max-time 20 "$DSHCTL_RAW_BASE/VERSION" 2>/dev/null | tr -d '[:space:]')
    case "$remote" in
        [0-9]*.[0-9]*.[0-9]*) ;;
        "") echo "取不到远端版本号（网络问题？），未做任何改动" >&2; return 1 ;;
        *)  echo "远端版本号异常：$remote，未做任何改动" >&2; return 1 ;;
    esac
    if [ "$remote" = "$DSHCTL_VERSION" ]; then
        echo "✓ dshctl 已是最新（$DSHCTL_VERSION）"
        return 0
    fi
    # 远端不高于本地时不要覆盖：本地可能装着还没推上去的修复，
    # 「版本号不同就覆盖」会把它们悄悄抹掉。
    if ! printf '%s\n%s\n' "$DSHCTL_VERSION" "$remote" | sort -V -C 2>/dev/null; then
        echo "远端是 $remote，不比本地 $DSHCTL_VERSION 新；自动覆盖会丢掉本地改动，已跳过。" >&2
        echo "确实要以远端为准：DSHCTL_FORCE_SELF_UPDATE=1 dshctl self-update" >&2
        [ "${DSHCTL_FORCE_SELF_UPDATE:-0}" = "1" ] || return 1
        echo "  已按 DSHCTL_FORCE_SELF_UPDATE=1 继续覆盖" >&2
    fi
    echo "  发现新版本：$DSHCTL_VERSION → $remote"
    if [ "$DRY_RUN" = "1" ]; then
        echo "── [dry-run] 只报版本不更新（去掉 --dry-run 才会真正执行）──"
        return 0
    fi
    tmp=$(mktemp "${TMPDIR:-/tmp}/dshctl-XXXXXX") || return 1
    if ! curl -fsSL --max-time 60 "$DSHCTL_RAW_BASE/dshctl" -o "$tmp"; then
        rm -f "$tmp"
        echo "下载新版失败，未做任何改动" >&2
        return 1
    fi
    if ! bash -n "$tmp" 2>/dev/null || ! grep -q "DSHCTL_VERSION=\"$remote\"" "$tmp"; then
        rm -f "$tmp"
        echo "下载内容校验未通过（语法或版本不符），未做任何改动" >&2
        return 1
    fi
    chmod --reference="$self" "$tmp" 2>/dev/null || chmod +x "$tmp"
    if ! mv -f "$tmp" "$self"; then
        rm -f "$tmp"
        echo "无法写入 $self（权限问题？），未做任何改动" >&2
        return 1
    fi
    echo "✓ dshctl 已更新到 $remote（当前进程仍是旧版，重新运行 dshctl 即生效）"
}

# ── 服务单元 ─────────────────────────────────────────────────────────────
# 单元由 dshctl 生成，是「这份安装怎么跑」的唯一事实来源。
write_unit_file() {
    local unit_dir prefix tmp
    unit_dir=$(dirname "$UNIT_FILE")
    mkdir -p "$unit_dir" || return 1
    prefix=$(npm_prefix) || { echo "取不到 npm 全局前缀" >&2; return 1; }
    tmp=$(mktemp "$unit_dir/.dsh-web.XXXXXX") || return 1
    if ! cat > "$tmp" <<EOF
[Unit]
Description=DeepSeek Harness Web (dsh)
After=network-online.target

[Service]
Type=simple
ExecStart=$prefix/bin/dsh web --host $HOST --port $PORT
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
EOF
    then
        rm -f "$tmp"
        return 1
    fi
    if ! chmod 644 "$tmp" || ! mv -f "$tmp" "$UNIT_FILE"; then
        rm -f "$tmp"
        return 1
    fi
    systemctl --user daemon-reload
}

# 重建启动配置：只修单元，不碰安装包、不碰数据。
repair_service() {
    local backup bin
    # repair 没有位置参数：多出来的东西一律拒绝，不猜（与"未知参数不执行"同一条原则）。
    if [ "$#" -ne 0 ]; then
        echo "用法：dshctl repair [--dry-run] [--no-restart]" >&2
        return 2
    fi
    for bin in systemctl npm node; do
        command -v "$bin" >/dev/null 2>&1 || { echo "修复需要 $bin，请先安装该命令" >&2; return 1; }
    done
    bin=$(dsh_bin) || return 1
    if [ ! -x "$bin" ]; then
        echo "还没装：$bin；先跑 dshctl upgrade" >&2
        return 1
    fi
    echo "重建 $UNIT（$HOST:$PORT），DSH 配置与数据保留"
    if [ "$DRY_RUN" = 1 ]; then
        echo "[dry-run] 将备份现有单元、重写单元并重新加载 systemd"
        [ "$RESTART" = 0 ] || echo "[dry-run] 将重启服务并检查应用应答"
        return 0
    fi
    mkdir -p "$STATE_DIR" || return 1
    backup=$(mktemp -d "$STATE_DIR/service-backup.XXXXXX") || return 1
    [ -f "$UNIT_FILE" ] && cp -Pp "$UNIT_FILE" "$backup/" 2>/dev/null
    echo "原配置备份：$backup"
    write_unit_file || return 1
    if [ "$RESTART" = 0 ]; then
        echo "✓ 启动配置已重建；已按 --no-restart 跳过重启"
        return 0
    fi
    if systemctl --user is-failed --quiet "$UNIT"; then
        systemctl --user reset-failed "$UNIT" || return 1
    fi
    restart_service
}

# ── 服务控制 ─────────────────────────────────────────────────────────────
# 等待服务真正可用：进程 active，且根路径给出应用级应答（认证重定向 3xx 或 401）。
# 连不上、404、5xx 都算没起来——只看 systemctl is-active 会漏判「起来一秒就崩」。
wait_healthy() {
    local i code tries
    if ! command -v curl >/dev/null 2>&1; then
        sleep 3
        systemctl --user is-active --quiet "$UNIT"
        return $?
    fi
    tries="${DSHCTL_HEALTH_TRIES:-30}"
    for i in $(seq 1 "$tries"); do
        if systemctl --user is-active --quiet "$UNIT"; then
            code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$URL/" 2>/dev/null || true)
            case "$code" in
                ""|000|404|5*) : ;;
                *) return 0 ;;
            esac
        fi
        sleep 1
    done
    return 1
}

restart_service() {
    if ! spinner "重启中" -- systemctl --user restart "$UNIT"; then
        echo "⚠ 服务重启失败，查看日志：dshctl log" >&2
        return 1
    fi
    if wait_healthy; then
        echo "✓ 服务已重启并运行：$URL"
        return 0
    fi
    echo "⚠ 服务重启后未给出应用级应答（可能起来又崩），查看日志：dshctl log" >&2
    return 1
}

# 重启失败就装回上一个版本再重启：一个坏制品不能让线上服务躺着。
restart_checked() {
    restart_service && return 0
    echo "  服务未起来，尝试装回上一个版本…" >&2
    if ! rollback_install; then
        echo "  ✘ 没有可回滚的版本，查看日志：dshctl log" >&2
        return 1
    fi
    if restart_service; then
        echo "  已回滚到 $(installed_version)，服务恢复运行" >&2
    else
        echo "  ✘ 回滚后服务仍未起来，查看日志：dshctl log" >&2
    fi
    return 1
}

# ── 安装事务：暂存 / 提交 / 回滚 ─────────────────────────────────────────
# 暂存：把确切版本装进隔离 prefix，全局树在这一步一行都不动。这样「预检失败」
# 才真的等于「线上什么都没变」，也不会留下装了一半的中间态。
stage_install() {
    local want="$1" root got
    root=$(mktemp -d "${TMPDIR:-/tmp}/dshctl-stage-XXXXXX") || return 1
    if ! spinner "暂存安装（隔离 prefix，不动全局树）" -- \
        npm install -g --prefix "$root" --no-audit --no-fund --prefer-offline \
        --fetch-timeout=120000 --fetch-retries=3 "$PACKAGE_NAME@$want"; then
        rm -rf "$root"
        return 1
    fi
    got=$("$root/bin/dsh" --version 2>/dev/null || true)
    if [ "$got" != "$want" ]; then
        echo "  暂存件版本异常：装到 ${got:-空}，目标是 $want" >&2
        rm -rf "$root"
        return 1
    fi
    STAGE_ROOT="$root"
}

# 提交：把已验证的确切版本装进全局树。装之前记下当前版本，服务起不来时才能退回去。
commit_install() {
    local want="$1" prev="$2" got
    case "$prev" in
        *[0-9]*) write_state "$PREV_VERSION_FILE" "$prev" ;;
        *)       echo "  ⚠ 读不到当前版本，本次提交无法回滚" >&2 ;;
    esac
    if ! spinner "提交到全局 npm 树" -- \
        npm install -g --no-audit --no-fund --prefer-offline \
        --fetch-timeout=120000 --fetch-retries=3 "$PACKAGE_NAME@$want"; then
        return 1
    fi
    got=$(installed_version)
    if [ "$got" != "$want" ]; then
        echo "  提交后版本为 $got，预期 $want" >&2
        return 1
    fi
    echo "  全局树：$PACKAGE_NAME@$want"
}

rollback_install() {
    local prev
    prev=$(read_state "$PREV_VERSION_FILE")
    case "$prev" in *[0-9]*) ;; *) echo "  没有记录上一个版本，无法回滚" >&2; return 1 ;; esac
    echo "  回滚全局树到 $prev…" >&2
    spinner "回滚中" -- npm install -g --no-audit --no-fund --prefer-offline \
        --fetch-timeout=120000 --fetch-retries=3 "$PACKAGE_NAME@$prev" || return 1
    [ "$(installed_version)" = "$prev" ]
}

# ── 预检：这份安装能不能用当前 profile 启动 ──────────────────────────────
# 那份 dsh 是否认识 profile 的配置段，只有真正加载一次插件树才知道。
# 预检跑在暂存件上：正式安装就是全局树，先装再验等于拿线上做实验。
PREFLIGHT_TRIES="${DSHCTL_PREFLIGHT_TRIES:-25}"

# 试启用端口；只用 bash 的 /dev/tcp 探测，不依赖 ss / netstat。
# 试启用的空闲端口：让 node 绑一个临时端口再释放，由内核保证它是空的。
# 不能用「连不上就当作空闲」：这台机器的 WSL 对未监听端口不返回 RST 而是直接丢包，
# /dev/tcp 探测会一直挂着（实测 3091..3120 全部 hang），预检第一步就卡死。
preflight_free_port() {
    local port
    port=$(node -e '
        const s = require("net").createServer();
        s.on("error", () => process.exit(1));
        s.listen(0, "127.0.0.1", () => { console.log(s.address().port); s.close(); });
    ' 2>/dev/null) || return 1
    case "$port" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s' "$port"
}

# 打印试启日志里最能说明问题的那几行。
preflight_report() {
    local log="$1" lines
    [ -f "$log" ] || return 0
    lines=$(grep -iE "error|invalid|unknown|failed" "$log" 2>/dev/null | tail -3)
    [ -n "$lines" ] || lines=$(tail -3 "$log" 2>/dev/null)
    [ -n "$lines" ] && printf '%s\n' "$lines" | sed 's/^/    /' >&2
    return 0
}

# 收掉试启进程组与临时 home（web 会派生子进程，按进程组杀，避免留孤儿）。
preflight_cleanup() {
    local home="$1" pid="$2"
    if [ -n "$pid" ] && [ "$pid" != "0" ]; then
        kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
        sleep 1
        kill -9 -- "-$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
    fi
    rm -rf "$home"
    return 0
}

# 试启用 DSH_HOME：只带启动判定需要的部分（插件树与 profile 才是判据）。
# profile 可能把监听端口写死——remote-web-ui 的 lan-bind 块会往 cordis.patch.yml 写
# host-webserver.port，而配置里的端口优先于命令行 --port。不把这处也改到空闲端口，
# 试启就会和线上服务抢同一个端口：预检永远 EADDRINUSE，还会被误报成「装的东西起不来」。
preflight_prepare_home() {
    local want_port="$1" home item link original resolved f changed=0
    home=$(mktemp -d "${TMPDIR:-/tmp}/dsh-preflight-XXXXXX") || return 1
    for item in profiles settings.yaml AGENTS.md; do
        [ -e "$HOME/.dsh/$item" ] && cp -a "$HOME/.dsh/$item" "$home/" 2>/dev/null
    done
    if [ -d "$home/profiles" ]; then
        # 临时副本中的外部相对软链接需要指向原来的有效目标。
        while IFS= read -r -d '' link; do
            [ -e "$link" ] && continue
            original="$HOME/.dsh/${link#"$home/"}"
            resolved=$(readlink -e "$original") || continue
            ln -sfn "$resolved" "$link"
        done < <(find "$home/profiles" -type l -print0)
    fi
    if [ "$want_port" != "$PORT" ] && [ -d "$home/profiles" ]; then
        for f in "$home"/profiles/*/cordis*.yml; do
            [ -f "$f" ] || continue
            grep -qE "^[[:space:]]*port:[[:space:]]*$PORT[[:space:]]*$" "$f" 2>/dev/null || continue
            sed -i -E "s/^([[:space:]]*port:[[:space:]]*)$PORT([[:space:]]*)$/\1$want_port\2/" "$f"
            changed=$((changed + 1))
        done
    fi
    if [ "$changed" -gt 0 ]; then
        echo "  试启用临时 home：profile 写死的端口 $PORT 已改到 $want_port（仅副本）" >&2
    fi
    printf '%s' "$home"
}

# profile 里精确钉死的 @deepseek-ai/* 必须与目标核心同版本：这类错配只在浏览器里
# 现形（插件客户端 entry 激活失败），服务端 HTTP 应答完全正常，所以要在起服务之前拦下。
# 判据两条：声明的精确版本等于目标；实装版本等于声明（改了声明没 pnpm install 也算错配）。
# 只看服务真正加载的那个 profile；也不能拿 profile 里所有 @deepseek-ai/* 跟核心比——
# cosmokit、schemastery 也在同一个 scope 下但版本独立，全比会稳定误报。
profile_pin_check() {
    local target="$1" pkg name version pinned installed bad=0
    case "$target" in [0-9]*.[0-9]*.[0-9]*) ;; *) return 0 ;; esac
    if [ "${DSHCTL_SKIP_PROFILE_PIN_CHECK:-0}" = "1" ]; then
        echo "  profile 版本守卫已跳过（DSHCTL_SKIP_PROFILE_PIN_CHECK=1）"
        return 0
    fi
    pkg="$HOME/.dsh/profiles/$PROFILE/package.json"
    [ -f "$pkg" ] || return 0
    while IFS=$'\t' read -r name version; do
        [ -n "$name" ] || continue
        pinned="${version#[\^~]}"
        [ "$pinned" = "$version" ] || continue
        case "$pinned" in [0-9]*.[0-9]*.[0-9]*) ;; *) continue ;; esac
        if [ "$pinned" != "$target" ]; then
            printf '  profile 版本错配：%s 声明 %s=%s，目标核心 %s\n' "$PROFILE" "$name" "$version" "$target" >&2
            bad=1
        fi
        installed=$(node -p "try{require(process.argv[1]).version}catch(e){''}" \
            "$HOME/.dsh/profiles/$PROFILE/node_modules/$name/package.json" 2>/dev/null)
        if [ -n "$installed" ] && [ "$installed" != "$pinned" ]; then
            printf '  profile 安装未对齐：%s 的 %s 声明 %s、实装 %s（先在该 profile 目录 pnpm install）\n' \
                "$PROFILE" "$name" "$pinned" "$installed" >&2
            bad=1
        fi
    done < <(node -e 'const p=require(process.argv[1]);for(const [n,v] of Object.entries(p.dependencies??{}))if(n.startsWith("@deepseek-ai/")&&typeof v==="string")console.log(n+"\t"+v)' "$pkg" 2>/dev/null)
    if [ "$bad" = "1" ]; then
        printf '  预检失败：profile %s 里精确钉死的 @deepseek-ai/* 与目标核心 %s 不一致。\n' "$PROFILE" "$target" >&2
        printf '  在 %s/.dsh/profiles/%s 里把它们对齐到 %s 并 pnpm install，再重试。\n' \
            "$HOME" "$PROFILE" "$target" >&2
        echo "  （不推荐跳过：DSHCTL_SKIP_PROFILE_PIN_CHECK=1）" >&2
        return 1
    fi
    return 0
}

# 预检失败输出：把「制品坏了」和「试启环境撞车」分开说，否则用户会去找不存在的问题。
preflight_fail() {
    local home="$1" pid="$2" reason="$3" log="$1/preflight.log"
    echo "  预检失败：$reason" >&2
    if grep -qE 'EADDRINUSE' "$log" 2>/dev/null; then
        echo "    注意：这是端口被占用，属于试启环境冲突，不代表装的东西坏了。" >&2
        echo "    排查：grep -rn 'port:' $HOME/.dsh/profiles/*/cordis*.yml" >&2
    fi
    preflight_report "$log"
    preflight_cleanup "$home" "$pid"
    return 1
}

# 用一个安装根（暂存件或全局树）试启 web。返回 0 = 给出应用级应答。
preflight() {
    local root="$1" home log port pid i code version
    if [ "${DSHCTL_PREFLIGHT:-1}" = "0" ]; then
        echo "  预检已跳过（DSHCTL_PREFLIGHT=0）"
        return 0
    fi
    [ -x "$root/bin/dsh" ] || { echo "  预检：$root/bin/dsh 不存在" >&2; return 1; }
    version=$("$root/bin/dsh" --version 2>/dev/null) || version=""
    profile_pin_check "$version" || return 1
    if ! port=$(preflight_free_port); then
        echo "  预检：找不到空闲端口" >&2
        return 1
    fi
    home=$(preflight_prepare_home "$port") || return 1
    log="$home/preflight.log"
    DSH_HOME="$home" setsid "$root/bin/dsh" web --host "$HOST" --port "$port" --no-open >"$log" 2>&1 &
    pid=$!
    for i in $(seq 1 "$PREFLIGHT_TRIES"); do
        if ! kill -0 "$pid" 2>/dev/null; then
            preflight_fail "$home" "$pid" "启动即退出"
            return 1
        fi
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://$HOST:$port/" 2>/dev/null || true)
        case "$code" in
            401|303|200)
                # 应答之后再确认进程还活着：起一秒就崩的制品会在这里现形。
                sleep 1
                if kill -0 "$pid" 2>/dev/null; then
                    # 能应答不等于启动干净：可选 entry 激活失败只是 warning，
                    # 服务照样应答 401，所以必须读日志。
                    if grep -qE 'did not activate|startup failed' "$log" 2>/dev/null; then
                        preflight_fail "$home" "$pid" "能应答，但启动日志里有 entry 未激活"
                        return 1
                    fi
                    echo "  预检通过：能用 profile $PROFILE 启动"
                    preflight_cleanup "$home" "$pid"
                    return 0
                fi
                preflight_fail "$home" "$pid" "应答之后又退出了"
                return 1
                ;;
        esac
        sleep 1
    done
    preflight_fail "$home" "$pid" "在 ${PREFLIGHT_TRIES}s 内没有给出应用级应答"
    return 1
}

# 只预检：dshctl check。不安装、不重启。
do_check() {
    local prefix
    prefix=$(npm_prefix) || { echo "读不到 npm 全局前缀" >&2; return 1; }
    if [ ! -x "$prefix/bin/dsh" ]; then
        echo "还没装：$prefix/bin/dsh（先跑 dshctl upgrade）" >&2
        return 1
    fi
    echo "预检：已装版本 $(installed_version) 能否用 profile $PROFILE 启动（不重启）"
    preflight "$prefix"
}

# ── 安装 / 升级主流程 ────────────────────────────────────────────────────
# 四段：暂存 → 预检 → 提交 → 重启。顺序是这个函数存在的全部理由。
do_upgrade() {
    local tag want prev
    tag=$(resolve_tag "${1:-}")
    if ! valid_channel "$tag"; then
        echo "无效的通道或版本：$tag" >&2
        echo "可用：latest / next / alpha，或显式版本号（如 0.2.1-rc.5）" >&2
        return 2
    fi

    echo "── [1/4] 目标 ──"
    echo "  包：$PACKAGE_NAME@$tag（npm 全局树）"
    echo "  当前版本：$(installed_version)"

    if [ "$DRY_RUN" = "1" ]; then
        echo "  [dry-run] 将：暂存到隔离目录 → 用 profile $PROFILE 预检 → 提交全局树 → 重启"
        echo "── [dry-run] 跳过安装与重启（去掉 --dry-run 才会真正执行）──"
        return 0
    fi

    echo "── [2/4] 暂存（不动正在运行的安装）──"
    network_precheck || return 1
    want=$(npm_view_version "$tag") || return 1
    echo "  目标版本：$want"
    if ! stage_install "$want"; then
        echo "暂存失败：运行中的 $(installed_version) 没有被改动。" >&2
        return 1
    fi

    echo "── [3/4] 预检 ──"
    if ! preflight "$STAGE_ROOT"; then
        rm -rf "$STAGE_ROOT"
        echo "预检未通过：正式安装与运行中的服务都没有改动。" >&2
        return 1
    fi

    echo "── [4/4] 提交并重启 ──"
    prev=$(installed_version)
    if ! commit_install "$want" "$prev"; then
        rm -rf "$STAGE_ROOT"
        echo "提交失败：全局树可能不完整，用 dshctl status / dshctl log 确认，必要时 dshctl repair。" >&2
        return 1
    fi
    rm -rf "$STAGE_ROOT"
    write_state "$CHANNEL_FILE" "$tag"

    if [ "$RESTART" = "0" ]; then
        echo "── 已按 --no-restart 跳过重启；下次启动生效 ──"
        warn_if_stale
        return 0
    fi
    restart_checked
}

# 首次安装：把 dshctl 放进 PATH、写服务单元，然后直接完成安装。
do_install() {
    local self bin_dir
    self=$(readlink -f "${BASH_SOURCE[0]}")
    bin_dir="$HOME/.local/bin"

    echo "── [1/3] dshctl ──"
    if [ "$(command -v dshctl 2>/dev/null)" = "$self" ]; then
        echo "  ✓ 已在 PATH：$self"
    else
        mkdir -p "$bin_dir" || return 1
        cp -f "$self" "$bin_dir/dshctl" && chmod 755 "$bin_dir/dshctl" || return 1
        echo "  ✓ 已安装：$bin_dir/dshctl"
        case ":$PATH:" in
            *":$bin_dir:"*) ;;
            *) echo "  ⚠ $bin_dir 不在 PATH，请加入 shell 配置：export PATH=\"$bin_dir:\$PATH\"" ;;
        esac
    fi

    echo "── [2/3] 服务单元 ──"
    if ! command -v npm >/dev/null 2>&1; then
        echo "  ⚠ 未找到 npm：先装 Node.js，再跑 dshctl install" >&2
        return 1
    fi
    write_unit_file || return 1
    echo "  ✓ $UNIT_FILE"

    echo "── [3/3] 安装官方包 ──"
    do_upgrade ""
}

# ── 状态 ─────────────────────────────────────────────────────────────────
show_info() {
    local started
    echo "单元：$UNIT（$(systemctl --user is-active "$UNIT" 2>/dev/null || echo 未运行)）"
    echo "入口：$(dsh_bin 2>/dev/null || echo 未知)"
    echo "已装版本：$(installed_version)"
    echo "更新通道：$(current_channel)"
    started=$(systemctl --user show "$UNIT" -p ActiveEnterTimestamp --value 2>/dev/null || true)
    [ -n "$started" ] && echo "进程启动于：$started"
    warn_if_stale
    return 0
}

# ── 迁移：清掉双槽位时代的遗留 ───────────────────────────────────────────
# 那些 drop-in 会把服务指向早已没人维护的本地槽位——留着就是在撒谎。
cleanup_legacy() {
    local f changed=0
    for f in $LEGACY_DROPINS; do
        [ -f "$f" ] || continue
        if rm -f "$f"; then
            changed=1
            echo "已删除废弃的槽位配置：$f"
        fi
    done
    [ "$changed" = "1" ] || return 0
    rmdir "$LEGACY_DROPIN_DIR" 2>/dev/null || true
    systemctl --user daemon-reload
    echo "  服务现在按单元里的全局安装运行；重启后生效：dshctl restart"
    return 0
}

# ── 交互菜单 ─────────────────────────────────────────────────────────────
run_menu() {
    local choice
    menu() {
        [ -t 0 ] && clear 2>/dev/null || true
        echo "========================================="
        echo "  dsh web 服务管理    $URL"
        echo "  已装版本：$(installed_version)"
        echo "========================================="
        echo "  1) 升级 dsh（官方包）"
        echo "  2) 查看运行状态"
        echo "  3) 查看最近日志"
        echo "  4) 重启服务"
        echo "  5) 停止服务"
        echo "  6) 启动服务"
        echo "  7) 取消开机自启"
        echo "  8) 查看完整说明（help）"
        echo "  9) 换通道并升级（latest/next/alpha）"
        echo " 10) 预检当前安装（check）"
        echo " 11) 修复服务单元（repair，原配置先备份）"
        echo " 12) 更新 dshctl 自身（self-update）"
        echo "  0) 退出"
        echo "-----------------------------------------"
        echo "  也可直接敲：dshctl upgrade next / dshctl status / dshctl log"
        echo "========================================="
        printf '  请选择 [0-9] 或 10-12: '
    }
    pause() {
        echo
        printf '按回车继续...'
        read -r _ || true
    }
    while true; do
        menu
        read -r choice || { echo; break; }
        echo
        case "$choice" in
            1)  do_upgrade "" ;;
            2)  systemctl --user --no-pager status "$UNIT"; echo; show_info ;;
            3)  journalctl --user -u "$UNIT" -n 100 --no-pager ;;
            4)  restart_service ;;
            5)  systemctl --user stop "$UNIT" ;;
            6)  systemctl --user start "$UNIT" ;;
            7)  systemctl --user disable "$UNIT" ;;
            8)  show_usage ;;
            9)  printf '  输入通道名（latest/next/alpha）: '
                read -r tag || true
                [ -n "${tag:-}" ] && do_upgrade "$tag" ;;
            10) do_check ;;
            11) repair_service ;;
            12) self_update ;;
            0)  break ;;
            *)  echo "无效选择：$choice（请输入 0-9 或 10-12）" ;;
        esac
        pause
    done
}

# ── 帮助 ─────────────────────────────────────────────────────────────────
default_help_text() {
    cat <<'EOF'
dshctl - dsh web 服务的安装、升级与托管（只针对官方 npm 包）

常用命令：
  dshctl upgrade [通道|版本]  安装/升级官方包（默认沿用记住的通道）
  dshctl install              首次安装：dshctl 进 PATH + 写服务单元 + 装包
  dshctl status               服务状态、已装版本、是否在跑旧代码
  dshctl restart|start|stop   服务控制
  dshctl log                  最近日志
  dshctl check                预检当前安装能否用 profile 启动（不重启）
  dshctl repair               重建服务单元（原配置先备份）
  dshctl self-update          更新 dshctl 自身
  dshctl help                 显示帮助信息

升级为什么不会把服务升挂：
  1) 先把目标版本装进隔离的暂存目录，全局 npm 树与运行中的服务一行都不动；
  2) 用 profile web 在临时 DSH_HOME + 空闲端口试启暂存件，起不来就到此为止；
  3) 通过后才提交到全局树并重启，重启失败自动装回上一个版本。
  注意：预检用的临时 home 会把 profile 里写死的监听端口改到空闲端口（仅副本），
  否则试启会和线上服务抢同一个端口。
  dshctl status 会提示「磁盘上的包是否比运行中的进程新」——升级后没重启、或手工
  动过全局树时会出现那行告警，按提示 restart 即可。

通用开关：--dry-run 只说不做；--no-restart 装完不重启。
无参数运行时进入交互菜单。
EOF
}

show_usage() {
    case "${1:-}" in
        upgrade|up)   echo "用法：dshctl upgrade [通道|版本] [--dry-run] [--no-restart]" ;;
        install)      echo "用法：dshctl install（首次安装：dshctl 进 PATH + 写服务单元 + 装包）" ;;
        status)       echo "用法：dshctl status" ;;
        check|verify) echo "用法：dshctl check（预检当前安装，不安装不重启）" ;;
        repair)       echo "用法：dshctl repair [--dry-run] [--no-restart]（备份并重建服务单元）" ;;
        self-update)  echo "用法：dshctl self-update [--dry-run]" ;;
        "")           ;;
        *)            echo "用法：dshctl $1" ;;
    esac
    default_help_text
    return 0
}

# ── 入口 ─────────────────────────────────────────────────────────────────
main() {
    local arg
    # 帮助优先：命令行里只要有 help / -h / --help，就只打印帮助，绝不执行子命令。
    for arg in "$@"; do
        case "$arg" in
            help|-h|--help)
                case "${1:-}" in
                    help|-h|--help) show_usage "${2:-}" ;;
                    *) show_usage "$1" ;;
                esac
                return 0 ;;
        esac
    done
    # 「- 开头」的未知参数一律拒绝执行：宁可让用户重敲，也不猜他想干什么。
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n|--no-restart) ;;
            -*)
                echo "未知参数：$arg" >&2
                echo
                show_usage "${1:-}"
                return 2 ;;
        esac
    done
    # 再摘掉过程开关，它们不该混进通道 / 版本参数里。
    local -a args=()
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) DRY_RUN=1 ;;
            --no-restart) RESTART=0 ;;
            *) args+=("$arg") ;;
        esac
    done
    set -- "${args[@]}"

    cleanup_legacy

    case "${1:-}" in
        "" )                    run_menu ;;
        upgrade|up)             do_upgrade "${2:-}" ;;
        install)                do_install ;;
        status|s)               systemctl --user --no-pager status "$UNIT"; echo; show_info ;;
        log|l)                  journalctl --user -u "$UNIT" -n 100 --no-pager ;;
        restart|r)              restart_service ;;
        stop)                   systemctl --user stop "$UNIT" ;;
        start)                  systemctl --user start "$UNIT" ;;
        disable)                systemctl --user disable "$UNIT" ;;
        check|verify)           do_check ;;
        repair)                 shift; repair_service "$@" ;;
        self-update)            self_update ;;
        help|h|-h|--help)       show_usage "${2:-}" ;;
        # 这几个是已删除的功能：明确说清楚去哪，别让肌肉记忆撞空。
        source|src)
            echo "「运行来源」已删除：只有官方包一种安装，装的就是跑的。" >&2
            echo "看版本和服务状态：dshctl status" >&2
            return 2 ;;
        use|switch)
            echo "槽位切换已删除：没有第二个安装位置，也就没有来源可切。" >&2
            echo "安装/升级：dshctl upgrade [通道|版本]" >&2
            return 2 ;;
        docker)
            echo "docker 部署模式已删除：只保留官方包 + systemd 一条路。" >&2
            return 2 ;;
        update|u)
            echo "「update」有歧义，已停用：升级 dsh 用 dshctl upgrade，更新 dshctl 自身用 dshctl self-update。" >&2
            return 2 ;;
        * )
            echo "未知命令：$1" >&2
            echo
            show_usage
            return 1 ;;
    esac
}

# 直接执行时跑 main；被 source（自测脚本）时只加载函数，不产生副作用。
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
